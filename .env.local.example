# Copy this to .env.local for local dev (that file is gitignored).
# In production these are set as Vercel project environment variables instead.

# Required. Shared password gating the whole app.
BOARD_PASSWORD=change-me

# Optional for local dev - if unset, the app falls back to a local JSON file
# (data/state.local.json, seeded from data/state.seed.json) instead of Redis.
# Required in production. Vercel sets these automatically once an Upstash
# Redis database is attached to the project via the Storage marketplace.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional for local dev - if unset, attachment uploads fall back to writing
# under public/uploads instead of Vercel Blob. Required in production. Vercel
# sets this automatically once Blob storage is attached to the project via
# the Storage marketplace.
BLOB_READ_WRITE_TOKEN=
